{
  "buildCommand": "pnpm --filter @workspace/open-music run build",
  "outputDirectory": "artifacts/open-music/dist/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://openmusic-jnp8.onrender.com/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
